//! prelude.nest
//!    this file is automatically loaded into your program.

proc print(string: content) {
    write(1, content);
}

proc println(string: content) {
    print(content);
    print("\n");
}

proc printn(int: n) {
    var num = n;
    if (num < 0) {
        print("-");
        num = -num;
    }
    if (num >= 10) {
        printn(num / 10);
        printn(num % 10);
    } else {
        if (num == 0) {
            print("0");
        }
        if (num == 1){
            print("1");
        }
        if (num == 2){
             print("2");
        } 
        if (num == 3){
             print("3");
        }
        if (num == 4){
             print("4");
        }
        if (num == 5){
             print("5");
        }
        if (num == 6){
             print("6");
        }
        if (num == 7){
             print("7");
        }
        if (num == 8){
             print("8");
        }
        if (num == 9){
             print("9");
        }
    }
}

proc strlen(string: s) {
    var i = 0;
    while (read_byte(s + i) != 0) {
        i = i + 1;
    }
    return i;
}

proc memcpy(int: dest, int: src, int: count) {
    var i = 0;
    while (i < count) {
        write_byte(dest + i, read_byte(src + i));
        i = i + 1;
    }
}

proc concat(string: a, string: b) {
    var len_a = strlen(a);
    var len_b = strlen(b);
    var total = len_a + len_b;
    var result = sbrk(total + 4);

    memcpy(result, a, len_a);
    memcpy(result + len_a, b, len_b);

    write_byte(result + total, 0);
    
    return result;
}